{
  "name": "Trip",
  "type": "object",
  "properties": {
    "destination": {
      "type": "string",
      "description": "Travel destination city/region"
    },
    "country": {
      "type": "string",
      "description": "Country of the destination"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Trip start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Trip end date"
    },
    "travelers": {
      "type": "string",
      "enum": [
        "solo",
        "coppia",
        "famiglia",
        "amici",
        "gruppo"
      ],
      "description": "Who you're traveling with"
    },
    "budget": {
      "type": "string",
      "enum": [
        "economico",
        "medio",
        "lusso"
      ],
      "description": "Budget level"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Travel interests"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "wants_restaurants": {
      "type": "boolean",
      "description": "Whether the user wants AI to include restaurant suggestions in the tour"
    },
    "food_intolerances": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Food intolerances"
    },
    "favorite_foods": {
      "type": "string",
      "description": "Favorite foods"
    },
    "disliked_foods": {
      "type": "string",
      "description": "Disliked foods"
    },
    "meal_time_preference": {
      "type": "string",
      "description": "Preferred lunch time e.g. 13:00"
    },
    "dinner_time_preference": {
      "type": "string",
      "description": "Preferred dinner time e.g. 20:00"
    },
    "has_accommodation": {
      "type": "boolean",
      "description": "User already has accommodation booked"
    },
    "accommodation_name": {
      "type": "string",
      "description": "Name or address of the accommodation"
    },
    "wants_transfer_info": {
      "type": "boolean",
      "description": "User wants public transport directions from airport to hotel"
    },
    "arrival_airport": {
      "type": "string",
      "description": "Arrival airport code or name"
    },
    "arrival_datetime": {
      "type": "string",
      "description": "Arrival date and time"
    },
    "airport_transfer_preference": {
      "type": "string",
      "enum": [
        "pubblico",
        "taxi",
        "entrambi"
      ],
      "description": "Preferred transfer type from airport"
    },
    "itinerary": {
      "type": "array",
      "description": "AI-generated itinerary",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "number"
          },
          "date": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "duration_minutes": {
                  "type": "number"
                },
                "tip": {
                  "type": "string"
                },
                "lat": {
                  "type": "number"
                },
                "lng": {
                  "type": "number"
                },
                "booking_url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "activity_guides": {
      "type": "object",
      "description": "AI-generated guides for each visitable activity, keyed by activity name"
    },
    "activity_status": {
      "type": "object",
      "description": "User-set status for each activity (done/skip), keyed by activity name"
    },
    "activity_expenses": {
      "type": "object",
      "description": "Expenses per activity, keyed by activity name. Each value is an array of {amount, currency, note, date}"
    },
    "extra_expenses": {
      "type": "array",
      "description": "Extra/manual expenses added by the user",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "budget_limit": {
      "type": "number",
      "description": "User-defined total budget limit in chosen currency"
    },
    "budget_currency": {
      "type": "string",
      "description": "Currency used for budget tracking e.g. EUR"
    },
    "hotel_suggestions": {
      "type": "array",
      "description": "AI hotel suggestions",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "price_range": {
            "type": "string"
          },
          "booking_url": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "airport_transfer": {
      "type": "object",
      "description": "Airport to hotel transfer info",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "cost": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "description": "User-uploaded travel documents",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          }
        }
      }
    },
    "cover_image": {
      "type": "string",
      "description": "Cover image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "confirmed",
        "completed"
      ],
      "default": "planning"
    }
  },
  "required": [
    "destination",
    "start_date",
    "end_date"
  ]
}